2026-11-17 17:39:40.871 UTC [2311] demo_hia@demo_hia app=scrum39-admin STATEMENT:  CREATE TEMP VIEW s39 AS
	SELECT s.queryid,
	       s.calls,
	       round(s.total_exec_time::numeric, 1)                         AS total_ms,
	       round(s.mean_exec_time::numeric, 2)                          AS media_ms,
	       round(s.max_exec_time::numeric, 1)                           AS max_ms,
	       round(100 * s.total_exec_time / sum(s.total_exec_time) OVER (), 1) AS pct_total,
	       s.rows,
	       round(s.rows::numeric / nullif(s.calls, 0), 1)               AS filas_x_llamada,
	       s.shared_blks_hit,
	       s.shared_blks_read,
	       round(100.0 * s.shared_blks_hit / nullif(s.shared_blks_hit + s.shared_blks_read, 0), 1) AS hit_pct,
	       s.temp_blks_written,
	       round((s.blk_read_time)::numeric, 1)                        AS io_lectura_ms,
	       regexp_replace(s.query, '\s+', ' ', 'g')                     AS query
	FROM pg_stat_statements s
	JOIN pg_database d ON d.oid = s.dbid
	WHERE d.datname = current_database()
	  AND s.query !~* '(pg_stat_|pg_settings|pg_reload_conf|ALTER SYSTEM|pg_sleep|CREATE EXTENSION|pg_catalog|current_setting|s39)';
