# Copiar como .env (nunca subirlo a Git). infra/n8n/configurar.sh completa lo que falte o diga GENERAR.
N8N_HOST_PORT=5679
N8N_ENCRYPTION_KEY=GENERAR_CON_OPENSSL_RAND_HEX_32
# Web de Mailpit (correos que mandan los flujos)
MAILPIT_HOST_PORT=8026
# URL con la que n8n arma links (editor, aprobaciones). configurar.sh pone http://<IP de Tailscale>:5679/
N8N_PUBLIC_BASE_URL=http://localhost:5679/
# Cuenta owner (configurar.sh la crea si no existe)
N8N_OWNER_EMAIL=admin@gymhub.local
N8N_OWNER_PASSWORD=GENERAR
# Alertmanager → flujo 01 (Authorization: Bearer). Lo genera configurar.sh
N8N_ALERTAS_WEBHOOK_TOKEN=GENERAR
# Backend → flujo 04 (X-GymHub-Secret). Lo genera configurar.sh y lo copia a produccion/.env.prod
N8N_EVENTOS_SECRET=GENERAR
