# Variables que lee docker-compose.yml (opcional: si no existe .env se usan estos mismos valores por defecto).
# Deben coincidir con DB_* de backend/.env
DB_NAME=demo_hia
DB_USER=demo_hia
DB_PASS=demo_hia_pass
DB_PORT=5433

# pgAdmin 4 (SCRUM-34 - profile tools)
PGADMIN_DEFAULT_EMAIL=admin@gymhub.com
PGADMIN_DEFAULT_PASSWORD=admin1234
PGADMIN_PORT=5050
