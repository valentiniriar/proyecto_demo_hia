# Variables que lee docker-compose.yml. Copiar a .env (no versionado): cp .env.example .env
# OBLIGATORIAS: DB_NAME, DB_USER y DB_PASS. Sin ellas, docker compose falla (no hay valores por defecto).
# Deben coincidir con DB_* de backend/.env
DB_NAME=demo_hia
DB_USER=demo_hia
# Cambiar en despliegue
DB_PASS=demo_hia_pass
# Opcional (default 5433). Solo se publica en el host con el perfil dev.
DB_PORT=5433

# pgAdmin 4 (SCRUM-34 - profile tools)
PGADMIN_DEFAULT_EMAIL=admin@gymhub.com
PGADMIN_DEFAULT_PASSWORD=admin1234
PGADMIN_PORT=5050

# Cloudflare Tunnel (SCRUM-60). Solo para el túnel con nombre (perfil "tunel").
# El valor real va únicamente en .env (nunca en el repo). Ver docs/SCRUM-60-cloudflare-tunnel.md
CLOUDFLARE_TUNNEL_TOKEN=

# Backups automáticos de PostgreSQL (SCRUM-37)
BACKUP_CRON_SCHEDULE="0 3 * * *"
BACKUP_RETENTION_DAYS=7
RUN_BACKUP_ON_STARTUP=true
