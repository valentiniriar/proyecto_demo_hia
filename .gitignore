# Dependencias y builds
node_modules/
dist/
.angular/

# Secretos y configuracion local (NUNCA subir)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
cloudflared/*.json

# Dumps y backups de la base (pueden tener datos reales). Los scripts versionados
# de database/ (esquema y seed demo) se excluyen explícitamente de esta regla.
*.sql
!database/*.sql
# Para permitir el dataset de 6m 
!database/dataset/*.sql
# Para permitir la creacion de indices
!database/analisis/indices/*.sql
# Migraciones versionadas (se aplican sobre bases existentes) y scripts de medición
!database/migraciones/*.sql
!database/analisis/*.sql
*.sql.gz
*.dump
*.backup
*.bak
backups/
dumps/

# Logs / sistema / editores
*.log
# SCRUM-39: el log de PostgreSQL es la entrada del reporte pgBadger (evidencia)
!docs/evidencias/SCRUM-39/*.log
.DS_Store
Thumbs.db
.idea/

# Secretos y estado del servidor de producción (ver produccion/LEEME.md). Solo el LEEME se versiona.
produccion/*
!produccion/LEEME.md
