PORT=3000

# Base de datos (coinciden con los defaults de ../docker-compose.yml; el puerto 5433 evita chocar con un Postgres local en 5432)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=demo_hia
DB_USER=demo_hia
DB_PASS=demo_hia_pass

# Cualquier cadena larga y aleatoria
JWT_SECRET=

# MercadoPago (access token de prueba)
ACCESS_TOKEN=

# YouTube Data API v3 (https://console.cloud.google.com/apis/library/youtube.googleapis.com)
YOUTUBE_API_KEY=

# Login con Google (OAuth client id)
GOOGLE_CLIENT_ID=

# Envio de emails
EMAIL_USER=
EMAIL_PASS=

# IA para rutinas (Groq)
GROQ_API_KEY=

# Seguridad de la API (SCRUM-65). Todas opcionales: sin definir se usan estos defaults.
# Orígenes permitidos por CORS, separados por coma (con el front detrás de Nginx en el mismo dominio no hace falta)
# CORS_ORIGINS=http://localhost:4200,https://localhost:4200,http://localhost:8080
# Proxies delante del backend: false | número de saltos (cloudflared -> Nginx -> backend = 2) | lista de redes
# TRUST_PROXY=loopback, uniquelocal
# Intentos FALLIDOS de login permitidos por IP y ventana (ms)
# AUTH_RATE_LIMIT_MAX=5
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# Límite global de solicitudes por IP y ventana (ms)
# RATE_LIMIT_MAX=1000
# RATE_LIMIT_WINDOW_MS=900000
# Tamaño máximo del body JSON
# BODY_LIMIT=100kb

# Arquitectura Replicada (SCRUM-47)
# Opcional: Descomentar para separar tráfico de lecturas y escrituras
# DB_HOST_PRIMARY=localhost
# DB_PORT_PRIMARY=5433
# DB_HOST_REPLICA=localhost
# DB_PORT_REPLICA=5434
